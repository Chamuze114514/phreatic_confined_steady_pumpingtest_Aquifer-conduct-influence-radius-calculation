#说明：根据稳定流抽水试验数据，知道抽水井的抽水量和稳定降深，求含水层渗透系数和影响半径

#函数
def f(x, params):
    xk, xr = x.tolist()
    thick, rw, sw, q, type = params
    #print(f"thick = {thick} rw = {rw} sw = {sw} q = {q}")
    #潜水
    if type == 0:
        return [
            np.pi*xk*(2*thick-sw)*sw/q + math.log(rw) - xr,#抽水
            #np.pi*xk*(2*thick*sw + sw*sw)/q + math.log(rw) - xr,#注水
            math.log(2.0*sw) + 0.5*math.log(thick*xk) - xr
        ]
    
    #承压水
    if type == 1:
        return [
            np.pi*2.0*xk*thick*sw/q + math.log(rw) - xr,
            math.log(10.0*sw) + 0.5*math.log(xk) - xr
        ]

